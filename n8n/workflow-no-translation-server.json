            "notesInFlow": true,
            "credentials": {
                "googleApi": {
                    "id": "8J3FxwZXRI88u4AA",
                    "name": "Google Service Account account"
                }
            },
            "notes": "Writes all posts from this run into Weibo_YYYY-MM at the first empty row (row 1 is header). Uses USER_ENTERED so GOOGLETRANSLATE formulas evaluate."
        },
        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const j = $json;\n\nconst LS = \"\\u2028\";\n\nfunction escMdV2(s) {\n  s = (s ?? \"\").toString();\n  // Telegram MarkdownV2 reserved chars: _ * [ ] ( ) ~ ` > # + - = | { } . ! and backslash\n  // Put \"-\" at the end (or escape it) to avoid range parsing in the character class.\n  return s.replace(/([_*\\$begin:math:display$\\$end:math:display$()~`>#+=|{}.!\\\\-])/g, \"\\\\$1\");\n}\n\nfunction toTelegramLines(s) {\n  return (s ?? \"\").toString()\n    .replace(/\\\\r\\\\n/g, \"\\\\n\")\n    .replace(/\\\\r/g, \"\\\\n\")\n    .split(\"\\\\n\")\n    .join(LS);\n}\n\nfunction clip(s, maxLen) {\n  s = (s ?? \"\").toString();\n  if (s.length <= maxLen) return s;\n  return s.slice(0, Math.max(0, maxLen - 1)) + \"…\";\n}\n\nconst ACCOUNT_STYLE = {\n  f2lam: { title: \"F2 Lam\", emoji: \"🟣\" },\n  f2ma:  { title: \"F2 Ma\",  emoji: \"🔵\" },\n};\n\nconst style = ACCOUNT_STYLE[j.account_key] || { title: j.account_key || \"unknown\", emoji: \"🧵\" };\n\nconst cn = clip(j.cleaned_cn_raw || j.text_cn || \"\", 2600);\n\nconst header  = \"*\" + escMdV2(style.emoji) + \"\\\\u00A0\" + escMdV2(style.title) + \"*\";\nconst cnBlock  = \"*🇨🇳\\\\u00A0Original\\\\u00A0CN:*\" + LS + escMdV2(toTelegramLines(cn));\nconst linkLine = \"*🔗\\\\u00A0Link:*\" + LS + escMdV2(toTelegramLines(j.permalink || \"\"));\n\nconst msg = [header, cnBlock, linkLine].join(LS + LS);\n\nreturn {\n  ...j,\n  telegram_message: msg,\n};"
            },
            "name": "Build Telegram (CN-only)",
            "type": "n8n-nodes-base.code",
