        {
            "parameters": {
                "jsCode": "const sheetName = $items('Compute Month Sheet')[0].json.sheetName;\nconst meta = $items('Get Spreadsheet Tabs')[0].json;\nconst titles = (meta.sheets || []).map(s => s.properties?.title).filter(Boolean);\n\nconst exists = titles.includes(sheetName);\n\n// Columns:\n// A created_at\n// B account_key\n// C post_id\n// D permalink\n// E text_cn\n// F translation_vi (formula)\n// G reserved\n// H fingerprint\n// I fetched_at\nconst header = [[\n  'created_at',\n  'account_key',\n  'post_id',\n  'permalink',\n  'text_cn',\n  'translation_vi',\n  'reserved',\n  'fingerprint',\n  'fetched_at'\n]];\n\nreturn [{ json: { sheetName, sheetExists: exists, header } }];"
            },
