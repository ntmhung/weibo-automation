        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const FORUM_CHAT_ID = Number($env.TG_FORUM_CHAT_ID);\n\nconst THREAD_MAP = {\n  f2lam: 2,\n  f2ma: 3,\n  f2dinh: 84,\n  f2hien: 85,\n  f2van: 86,\n  f2nguyen: 87,\n  f2tuong: 88,\n  f2doan: 89,\n  f3chu: 79,\n  f3to: 80,\n  f3cuc: 81,\n  f3vu: 82,\n  f3hang: 83\n};\n\nconst thread_id = THREAD_MAP[$json.account_key] || null;\n\nreturn { ...$json, forum_chat_id: FORUM_CHAT_ID, thread_id };"
            },
            "name": "Map Topic",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -4304,
                -672
            ],
            "id": "7eaa34bd-f847-4dd8-a5e6-9884cae4a14b"
        },
        {
            "parameters": {
                "jsCode": "const MAX = 3900; // keep margin under 4096\nconst LS = \"\\u2028\";\n\nfunction splitOne(j) {\n  const text = (j.telegram_message || \"\").toString();\n  const blocks = text.split(LS + LS);\n\n  const parts = [];\n  let cur = \"\";\n\n  function pushCur() {\n    if (cur) parts.push(cur);\n    cur = \"\";\n  }\n\n  for (const b of blocks) {\n    const block = b || \"\";\n    const candidate = cur ? (cur + LS + LS + block) : block;\n\n    if (candidate.length <= MAX) {\n      cur = candidate;\n      continue;\n    }\n\n    if (cur) pushCur();\n\n    if (block.length > MAX) {\n      const lines = block.split(LS);\n      let cur2 = \"\";\n\n      for (const line of lines) {\n        const cand2 = cur2 ? (cur2 + LS + line) : line;\n        if (cand2.length <= MAX) {\n          cur2 = cand2;\n        } else {\n          if (cur2) parts.push(cur2);\n          let rest = line;\n          while (rest.length > MAX) {\n            parts.push(rest.slice(0, MAX));\n            rest = rest.slice(MAX);\n          }\n          cur2 = rest;\n        }\n      }\n\n      if (cur2) parts.push(cur2);\n    } else {\n      cur = block;\n    }\n  }\n\n  if (cur) pushCur();\n\n  const safeKey = (j.account_key || \"unknown\").toString().replace(/`/g, \"\");\n  const notice = \"*No\\u00A0topic\\u00A0mapping\\u00A0for:*\" + LS + \"`\" + safeKey + \"`\" + LS + LS;\n\n  return parts.map((p, idx) => ({\n    json: {\n      ...j,\n      telegram_part: p,\n      telegram_part_fallback: (idx === 0) ? (notice + p) : p,\n      part_index: idx,\n      part_count: parts.length\n    }\n  }));\n}\n\nconst inputItems = $input.all().map(i => i.json);\nconst out = [];\n\nfor (const j of inputItems) {\n  out.push(...splitOne(j));\n}\n\nreturn out;"
            },
