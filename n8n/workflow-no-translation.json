        {
            "parameters": {
                "jsCode": "const items = $items('Clean Weibo Text').map(i => i.json);\nif (!items.length) return [{ json: { skip: true } }];\n\nconst ts = items[0].fetched_at || new Date().toISOString();\nconst d = new Date(ts);\nconst yyyy = d.getUTCFullYear();\nconst mm = String(d.getUTCMonth() + 1).padStart(2, '0');\nconst sheetName = `Weibo_${yyyy}-${mm}`;\n\nreturn [{ json: { skip: false, sheetName } }];"
            },
