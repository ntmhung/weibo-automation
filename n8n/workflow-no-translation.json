        {
            "parameters": {
                "jsCode": "const sheetName = $items('Ensure Month Sheet Exists')[0].json.sheetName;\nconst colA = $items('Get Column A Used Rows (Monthly)')[0].json.values || [];\n\n// Row 1 is header => data starts at row 2\nconst dataCount = Math.max(0, colA.length - 1);\nconst nextRow = 2 + dataCount;\n\nconst items = $items('Clean Weibo Text').map(i => i.json);\nif (!items.length) return [{ json: { skip: true } }];\n\n// Build rows with 9 columns (A..I)\n// translation_vi is column F, formula references column E of the SAME row.\nconst rows = items.map((p, idx) => {\n  const rowNum = nextRow + idx;\n  const formula = `=GOOGLETRANSLATE(E${rowNum},\"zh\",\"vi\")`;\n\n  return [\n    p.created_at || '',\n    p.account_key || '',\n    p.post_id || '',\n    p.permalink || '',\n    p.cleaned_cn_escaped || '',\n    formula,\n    '',\n    p.fingerprint || '',\n    p.fetched_at || ''\n  ];\n});\n\nconst start = nextRow;\nconst end = nextRow + rows.length - 1;\nconst range = `${sheetName}!A${start}:I${end}`;\n\nreturn [{ json: { skip: false, range, values: rows } }];"
            },
